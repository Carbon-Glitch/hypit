<?svml using="@hypit/markup@1"?>
<svml>
  <import as="sound" from="@hypit/sound@1"/>
  <import as="performance" from="@hypit/performance@1"/>
  <import from="@hypit/script@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="pipeline" from="@hypit/media-pipeline@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="program" from="@hypit/program-space@1"/>
  <import as="fonts" from="@hypit/fonts-open@1"/>
  <import as="typo" from="@hypit/typography-track@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="look" source="./look.svs"/>

  <script id="story">
    <opening><LEAD>Why did you bring @{proof}this envelope?@{/proof}</opening>
  </script>
  <space:Canvas id="canvas" width="720" height="1280"/>
  <program:Clock id="clock" frame-rate="30"/>
  <space:Frame id="full" within={canvas}
    left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="title-frame" within={canvas}
    left="8%" top="12%" right="92%" bottom="30%"/>

  <!-- Accepted H3 media supplied by this project, not a new generation request. -->
  <asset:Video id="accepted-shot" src="./assets/accepted-h3-shot.mp4"/>
  <pipeline:Normalize id="performance-media" source={accepted-shot} clock={clock}
    video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:SemanticTake id="opening-semantic" narrative={story}
    segment={story.segment.opening} media={performance-media.media} language="en"/>
  <time:Timeline id="speech" clock={clock}>
    <time:Take source={opening-semantic.take}/>
  </time:Timeline>

  <sound:Style id="speech-sound-style"/>
  <sound:Track id="speech-sound" timeline={speech.timeline}>
    <sound:Use style={speech-sound-style}/>
  </sound:Track>
  <performance:Style id="speech-picture-style" frame={full} appearance={look.media.performance}/>
  <performance:Track id="speech-picture" timeline={speech.timeline} canvas={canvas}>
    <performance:Use style={speech-picture-style} during="program"/>
  </performance:Track>

  <fonts:Stack id="title-font" family="inter" weight="700" style="normal" emoji="color"/>
  <typo:Style id="title-style" recipe={look.text.title} font={title-font}>
    <typo:Fill color="#F1E7D8"/>
  </typo:Style>
  <typo:Track id="titles" timeline={speech.timeline}>
    <typo:Area id="proof-label" placement={title-frame} style={title-style}
      during={story.selection.proof}>The envelope</typo:Area>
  </typo:Track>
  <film:Film id="main" canvas={canvas} timeline={speech.timeline} appearance={look.film.main}>
    <film:Track source={speech-picture.visual}/>
    <film:Track source={speech-sound.audio}/>
    <film:Track source={titles.track}/>
  </film:Film>
  <render:Video id="final" composition={main.composition} timeline={speech.timeline}/>
  <render:Video id="detail" composition={main.composition} timeline={speech.timeline}
    start-frame="30" end-frame-exclusive="90"/>
</svml>
